{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/money.test.ts lib/format.test.ts lib/availability.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-locations": "tsx prisma/seed-locations.ts",
    "db:seed-profiles": "tsx prisma/seed-profiles.ts",
    "db:import-csv": "tsx prisma/import-csv.ts",
    "db:seed-demo": "tsx prisma/seed-demo-pipeline.ts",
