# Local: file:./dev.db after `npm run db:seed`
# Vercel: omit to use the bundled prisma/demo.db snapshot, or set a Postgres URL later
# Production domain: https://caregiver.com.au
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-32-character-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://caregiver.com.au"
PLATFORM_FEE_BPS="1000"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Analytics (optional). Leave BOTH blank to ship zero third-party scripts and
# zero tracking. Set ONE provider to enable privacy-conscious analytics:
#   - GA4:        NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
#   - Plausible:  NEXT_PUBLIC_PLAUSIBLE_DOMAIN="caregiver.com.au"
# If both are set, GA4 takes precedence.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Google Search Console verification (optional). Paste the token from the
# "HTML tag" verification method (the content="..." value) to emit the
# <meta name="google-site-verification"> tag site-wide.
GOOGLE_SITE_VERIFICATION=""
