# Local: file:./dev.db after `npm run db:seed`
# Vercel preview: omit DATABASE_URL to use the bundled prisma/demo.db snapshot
# Production: Postgres URL. Domain is https://caregiver.com.au
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-32-character-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://caregiver.com.au"
# Local/preview stay demo when unset. Set false on Vercel production.
NEXT_PUBLIC_DEMO_MODE="true"
# Optional. Hide fake ABN on invoices until a real number is set.
# NEXT_PUBLIC_PLATFORM_ABN="12 345 678 901"
PLATFORM_FEE_BPS="1000"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
